# 실제 로컬 API. 화면 목업만 필요하면 VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCK_API=false
# 스크롤 중 화면을 바로 보낼 Vision AI 주소. 토큰은 로컬 개발용(확장에 들어간 값은 누구나 볼 수 있으니 운영 토큰 금지)
VITE_VISION_BASE_URL=http://127.0.0.1:8100
VITE_VISION_TOKEN=
# 분석 흐름 콘솔 로그(비밀번호·토큰은 가림). 개발 중에만 true
VITE_DEBUG_LOG=false
