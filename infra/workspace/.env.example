# Generated by python tools/workspace.py init. Do not use example passwords.
WORKSPACE_TOKEN=generated-by-init
REDIS_PASSWORD=generated-by-init
WEB_PORT=3000
DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
TEMP_IMAGE_TTL_SECONDS=3600
LLM_MODE=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 추천 순서를 LLM으로: RECO_RANKER=claude(ANTHROPIC_API_KEY 필요) 또는 local(LOCAL_LLM_BASE_URL/MODEL/API_KEY)
RECO_RANKER=rule
RECO_LLM_MODEL=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# 추천 관련도 기준점(0~1, 비우면 0.5). 너무 높으면 추천이 비어요
RECO_MIN_SCORE=
# 가장 비슷한 후보보다 이만큼 낮으면 제외(비우면 0.25)
RECO_SCORE_MARGIN=
# integrated에서 연결 확인용 어댑터 8개 끄기(on/off)
WORKSPACE_DEV_ADAPTERS=on
