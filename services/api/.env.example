# Generate real development credentials with python services/api/dev.py init.
# Never commit services/api/.env.
API_PORT=8000
COLLECTOR_TOKEN=
APP_ENV=development
BILLING_MODE=disabled
MOCK_PAYMENT_OUTCOME=succeeded
BILLING_TEST_TOKEN=
CATALOG_CURRENCIES=KRW,USD,AUD,EUR,INR,GBP,JPY,CNY
CATALOG_PRICE_RATIO=10
ANALYSIS_WORKER_TOKEN=
AFFILIATE_URL_HOSTS=store.example.test
# Adpick affiliate link conversion (POST /v2/links/convert). Put the real key only in services/api/.env.
# Upstream allows 60 requests/min and answers HTTP 400 for unsupported shopping URLs.
ADPICK_API_KEY=
ADPICK_API_URL=
ADPICK_REQUESTS_PER_MINUTE=60
ADPICK_CLIENT_PER_MINUTE=10
ADPICK_AUTH_HEADER=Authorization
ADPICK_AUTH_SCHEME=Bearer
ADPICK_URL_PARAM=url
# Cards flag a listing as stale when its sale was not confirmed for this many hours.
CATALOG_STALE_HOURS=72
