COLLECTOR_RELEASE=review-required
COLLECTOR_RUN_APPROVED=no
COLLECTOR_DELIVERY_APPROVED=no
CONFIG_DIR=/volume1/docker/kkulpick-collectors-v2/config
SECRETS_DIR=/volume1/docker/kkulpick-collectors-v2/secrets
MASTER_STATE_DIR=/volume1/docker/kkulpick-collectors-v2/state/master
DISCOVERY_METADATA_APPROVED=no
# Backend-only. External source policy remains HTTPS/public-IP/TLS verified.
COLLECTOR_BACKEND_TRANSPORT=https
COLLECTOR_BACKEND_BASE_URL=
COLLECTOR_INTERNAL_HTTP_APPROVED=no
COLLECTOR_INTERNAL_NETWORK_ID=
COLLECTOR_INTERNAL_NETWORK_NAME=kkulpick-ingest-reviewed
INTERNAL_REVIEW_DIR=/volume1/docker/kkulpick-collectors-v2/network-review
